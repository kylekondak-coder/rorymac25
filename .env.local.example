NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret key — server-only, never exposed to the browser. Used for the
# building share-link page, which fetches by token and bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" so the
# reminder endpoint can't be triggered by anyone else. Any random string.
CRON_SECRET=generate-a-random-string
# Public site URL — reminder emails are sent outside a request, so there's
# no host header to derive links from.
SITE_URL=https://your-deployed-domain.vercel.app
# From resend.com — needed to actually send reminder emails.
RESEND_API_KEY=your-resend-api-key
# Optional: defaults to Resend's sandbox sender until you verify your own domain.
EMAIL_FROM=Papertrail <onboarding@resend.dev>
